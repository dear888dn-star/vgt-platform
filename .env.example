# Server porti
PORT=3000
# Sessiya tokenlari uchun maxfiy kalit (uzun tasodifiy satr). Majburiy!
JWT_SECRET=bu-yerga-uzun-tasodifiy-satr-yozing
# Birinchi ishga tushishda yaratiladigan administrator
ADMIN_EMAIL=admin@vgt.uz
ADMIN_PASSWORD=kuchli-parol
# Claude API kaliti — virtual gidlik trenajyorining AI rejimi uchun (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Ixtiyoriy: model (standart: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
# Ixtiyoriy: AI ni majburan o'chirish
# AI_MODE=offline
# Ixtiyoriy: ma'lumotlar bazasi papkasi
# DATA_DIR=./storage
# HTTPS orqali ishlaganda cookie'ni xavfsiz qilish uchun
# NODE_ENV=production
